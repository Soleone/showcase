{
  "name": "@soleone/showcase",
  "version": "0.2.0",
  "description": "Grade how demoable a project is, from D to S, and get the next steps to raise it.",
  "license": "MIT",
  "author": "Soleone",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soleone/showcase.git"
  },
  "homepage": "https://github.com/Soleone/showcase#readme",
  "bugs": "https://github.com/Soleone/showcase/issues",
  "keywords": [
    "portfolio",
    "readme",
    "demo",
    "cli",
    "pi-package",
    "agent-skill"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./capture": "./src/capture.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "showcase": "./bin/showcase.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "recipes/",
    "skills/",
    "docs/playbook.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/showcase.js check demo/projects/*",
    "demo:browser": "node bin/showcase.js terminal --serve",
    "media:capture": "node scripts/capture-demo.mjs"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
